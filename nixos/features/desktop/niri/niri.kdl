// ==================== INPUT ==================== //
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            layout "br";
            variant "nodeadkeys";
            options "compose:rctrl";
        }
        numlock
    }
    touchpad { off; }
    mouse { }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }
    hot-corners {
        off
        top-left
    }
}

prefer-no-csd

// ==================== LAYER RULES ==================== //
layer-rule {
    match namespace="^noctalia-backdrop$"
    place-within-backdrop true
}
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ==================== WINDOW RULES ==================== //
// https://niri-wm.github.io/niri/Configuration:-Window-Rules
window-rule { draw-border-with-background false; }
window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.5; }
}
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
}
// large floating windows
window-rule {
    match app-id="^nemo$"
    match app-id="^org.kde.dolphin$"
    match app-id="^org.gnome.Nautilus$"
    match app-id="^org.gnome.gThumb$"
    match app-id="^dev.noctalia.Noctalia.Settings$"
    match app-id="^dev.noctalia.Noctalia$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.75; }
}
// just float
window-rule {
    match title="^Zed — Settings$"
    match app-id="^org.gnome.Calculator$"
    match app-id="^org.gnome.FileRoller$"
    open-floating true
}
// make the godot embed game window floating
window-rule {
    match app-id="Godot"
    exclude title="^Godot$"
    open-floating true
}
// steam subwindows should float
window-rule {
    match app-id="steam"
    exclude title=r#"^Steam$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.75; }
}
// window-rule {
//     match app-id="org.satty.satty"
//     open-floating true
//     default-column-width { proportion 1.0; }
//     default-window-height { proportion 1.0; }
//     open-focused true
// }

output "HDMI-A-1" {
    position x=0 y=0
    focus-at-startup
    mode "1600x900@75.000"
}
