// ==================== INPUT ==================== //
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            layout "br";
            variant "nodeadkeys";
            options "compose:rctrl";
        }
        numlock
    }
    touchpad { off; }
    mouse { }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }
    hot-corners {
        off
        top-left
    }
}

prefer-no-csd

// ==================== LAYER RULES ==================== //
layer-rule {
    match namespace="^noctalia-backdrop$"
    place-within-backdrop true
}
// layer-rule {
//     match namespace="^noctalia-notification$"
//     block-out-from "screencast"
// }
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ==================== WINDOW RULES ==================== //
// https://niri-wm.github.io/niri/Configuration:-Window-Rules
window-rule { draw-border-with-background false; }
window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.5; }
}
window-rule {
    match app-id="dropdown-kitty"
    open-floating true
    default-floating-position x=0 y=0 relative-to="top"
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.5; }
}
window-rule {
    match app-id="zen$" title="^Picture-in-Picture$"
    default-floating-position x=32 y=32 relative-to="top-right"
    open-floating true
}
window-rule {
    match app-id="^nemo$"
    match app-id="^org.kde.dolphin$"
    match app-id="^org.gnome.Nautilus$"
    match app-id="^org.gnome.gThumb$"
    match app-id="^dev.noctalia.Noctalia.Settings$"
    match app-id="^dev.noctalia.Noctalia$"
    match app-id="steam"
    match title="^Steam$"
    match title="Sign in"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.75; }
}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
window-rule {
    match title="^Zed — Settings$"
    match app-id="^org.gnome.Calculator$"
    match app-id="^org.gnome.FileRoller$"
    open-floating true
}
window-rule {
    match app-id="Godot"
    exclude title="^Godot$"
    open-floating true
}
window-rule {
    match app-id="steam"
    exclude title=r#"^Steam$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.75; }
}

output "HDMI-A-1" {
    position x=0 y=0
    focus-at-startup
    mode "1600x900@75.000"
}
